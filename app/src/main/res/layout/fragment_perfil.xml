<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="24dp"
    android:paddingEnd="28dp">

    <TextView style="@style/Inc.Greeting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Perfil" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="22dp">
        <TextView style="@style/Inc.Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Correo electrónico" />
        <TextView android:id="@+id/tvEmail" style="@style/Inc.BodySemi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCerrarSesion"
        style="@style/Inc.BodySemi"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_button_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Cerrar sesión"
        android:textColor="@color/inc_card" />
</LinearLayout>
