<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movimientos"
            android:textColor="#14284B"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="Consulta y administra tus ingresos y gastos"
            android:textColor="#5F6368"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Este mes"
            android:textColor="#14284B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIngresosMes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingresos: +$0"
            android:textColor="#14284B" />

        <TextView
            android:id="@+id/tvGastosMes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Gastos: -$0"
            android:textColor="#14284B" />

        <RadioGroup
            android:id="@+id/rgFiltro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:checkedButton="@id/rbTodos"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todos" />

            <RadioButton
                android:id="@+id/rbIngresos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresos" />

            <RadioButton
                android:id="@+id/rbGastos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gastos" />
        </RadioGroup>

        <Button
            android:id="@+id/btnNuevo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#14284B"
            android:text="Agregar movimiento"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historial"
            android:textColor="#14284B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/listaMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Aún no tienes movimientos"
            android:textColor="#5F6368"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVerMas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Ver más movimientos"
            android:textColor="#14284B"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCerrarSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="Cerrar sesión"
            android:textColor="#14284B"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
